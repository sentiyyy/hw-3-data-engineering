# Local-only RustFS credentials. Change both values before exposing ports beyond localhost.
RUSTFS_ACCESS_KEY=analyst10local
RUSTFS_SECRET_KEY=ChangeThisLocalSecret_2026_10

# The pipeline runs inside Docker Compose, so use the service name, not localhost.
S3_ENDPOINT_URL=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=hh-lake
S3_OBJECT_KEY=raw/analyst/vacancies.jsonl

# HH API
HH_USER_AGENT=AnalystVariant10/1.0 (educational project)
HH_REQUEST_DELAY_SECONDS=0.12

# Analysis
CHUNK_SIZES=100,500,1000
PROFILE_ATTEMPTS=3
MIN_COMBO_SUPPORT=5
ARTIFACTS_DIR=/app/artifacts
